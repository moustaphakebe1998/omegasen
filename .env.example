# ── Général ───────────────────────────────────────────
ENVIRONMENT=development
PUBLIC_APP_URL=http://localhost:3100
API_PUBLIC_URL=http://localhost:8100

# ── Sécurité (OBLIGATOIRE en production : `openssl rand -hex 32`) ──
JWT_SECRET=change-me-dev-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3100

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=omegasen
POSTGRES_PASSWORD=omegasen
POSTGRES_DB=omegasen
DATABASE_URL=postgresql+asyncpg://omegasen:omegasen@localhost:54330/omegasen

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:63790/0

# ── Stockage S3 (MinIO en dev) ────────────────────────
S3_ENDPOINT_URL=http://localhost:9010
S3_PUBLIC_BASE_URL=http://localhost:9010/omegasen-media
S3_ACCESS_KEY=omegasen
S3_SECRET_KEY=omegasen-secret
S3_BUCKET=omegasen-media
S3_REGION=us-east-1
MAX_UPLOAD_MB=10

# ── Production (docker compose) ───────────────────────
# Image MinIO (les images officielles ne sont plus publiées sur Docker Hub)
MINIO_IMAGE=
HTTP_PORT=80
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# ── Super admin initial (créé au premier démarrage si absent) ──
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMe!2026

# Comptes : validité des liens envoyés par email
ACTIVATION_TTL_HOURS=72
RESET_TTL_MINUTES=60

# Emails (SMTP). Laisser SMTP_HOST vide en développement : les emails sont écrits dans les journaux.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=OmegaSen <no-reply@omegasen.local>
