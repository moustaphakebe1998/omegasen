# Copier en .env.local (dev) ou configurer dans Vercel (prod).
DATABASE_URL=postgresql://omegasen:omegasen@localhost:54329/omegasen
DATABASE_URL_UNPOOLED=postgresql://omegasen:omegasen@localhost:54329/omegasen

# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
# openssl rand -hex 16
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optionnel — rate limiting (Upstash / Vercel KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optionnel — rapport quotidien par e-mail (Resend)
RESEND_API_KEY=
RESEND_TO_EMAIL=
FROM_EMAIL=
