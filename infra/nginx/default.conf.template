# Reverse proxy OmegaSen. TLS : placer un terminateur (Caddy/Traefik/certbot) devant,
# ou ajouter un bloc `listen 443 ssl` avec vos certificats.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

upstream omegasen_backend  { server backend:8000; }
upstream omegasen_frontend { server frontend:3000; }

server {
  listen 80;
  server_name _;
  client_max_body_size 12m;
  server_tokens off;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  gzip on;
  gzip_types text/plain text/css application/json application/javascript image/svg+xml;

  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;

  # WebSockets temps réel (cuisine, caisse, suivi client)
  location /api/ws/ {
    proxy_pass http://omegasen_backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
  }

  location /api/ {
    proxy_pass http://omegasen_backend;
  }

  location = /health {
    proxy_pass http://omegasen_backend;
  }

  # Images publiques (seul le préfixe public/ est lisible, cf. politique du bucket)
  location /media/ {
    proxy_pass http://minio:9000/${S3_BUCKET}/;
    proxy_set_header Host minio:9000;
    proxy_hide_header Set-Cookie;
    limit_except GET HEAD { deny all; }
    expires 30d;
  }

  location / {
    proxy_pass http://omegasen_frontend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
